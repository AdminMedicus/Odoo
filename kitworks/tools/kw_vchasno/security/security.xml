<odoo noupdate="1">
    <record id="module_category_kw_vchasno" model="ir.module.category">
        <field name="name">Vchasno</field>
        <field name="sequence">30</field>
    </record>
    <record id="group_kw_vchasno_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id"
               ref="kw_vchasno.module_category_kw_vchasno"/>
    </record>
    <record id="group_kw_vchasno_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id"
               ref="kw_vchasno.module_category_kw_vchasno"/>
        <field name="implied_ids"
               eval="[(4, ref('kw_vchasno.group_kw_vchasno_user')),]"/>
    </record>
    <record id="group_kw_vchasno_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id"
               ref="kw_vchasno.module_category_kw_vchasno"/>
        <field name="implied_ids"
               eval="[(4, ref('kw_vchasno.group_kw_vchasno_manager')),]"/>
        <field name="users"
               eval="[(4, ref('base.user_root')), (4, ref('base.user_admin')), ]"/>
    </record>
</odoo>

