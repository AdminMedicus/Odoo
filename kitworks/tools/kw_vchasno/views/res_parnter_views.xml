<odoo>

    <record id="kw_vchasno_res_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form (kw_vchasno)</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Vchasno Documents">
                            <field name="vchasno_documents_ids" nolabel="1"/>
                    </page>
                </xpath>
        </field>
    </record>
</odoo>
