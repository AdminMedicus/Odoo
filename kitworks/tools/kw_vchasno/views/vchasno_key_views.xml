<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kw_vchasno_kw_vchasno_key_search" model="ir.ui.view">
        <field name="name">kw.vchasno.key.search (kw_vchasno)</field>
        <field name="model">kw.vchasno.key</field>
        <field eval="8" name="priority"/>
        <field name="arch" type="xml">
            <search string="Vchasno">
                <field name="name"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>

    <record id="kw_vchasno_kw_vchasno_key_list" model="ir.ui.view">
        <field name="name">kw.vchasno.key.list (kw_vchasno)</field>
        <field name="model">kw.vchasno.key</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="user_id"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="is_log_enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="kw_vchasno_kw_vchasno_key_form" model="ir.ui.view">
        <field name="name">kw.vchasno.key.form (kw_vchasno)</field>
        <field name="model">kw.vchasno.key</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button class="btn btn-primary" name="update_categories" string="Update Categories" type="object"/>
                    <button class="oe_stat_button" name="update_incoming_documents" string="Download Incoming Document" type="object"/>
                    <button class="oe_stat_button" name="update_outgoing_documents" string="Download Outgoing Document" type="object"/>
                    <button class="oe_stat_button" name="update_document_inf" string="Update Document Info" type="object"/>
                </header>
                <sheet>
                    <div name="button_line">
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-copy" name="document_action" string="Vchasno Document" type="object">
                            </button>
                        </div>
                    </div>
                    <div name="button_line" style="width: 100%">
                        <div class="oe_button_box" name="button_box" style="width: 100%; ">
                        </div>
                    </div>
                    <widget bg_color="bg-danger" invisible="active == True" name="web_ribbon" title="Archived"/>
                    <field invisible="1" name="active"/>
                    <div name="title_line" style="width: 100%">
                        <div class="oe_title">
                            <label class="oe_edit_only" for="name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="token" password="True"/>
                            <field name="company_id"/>
                            <field name="edrpou_owner"/>
                            <field name="email_owner"/>
                            <field name="user_id"/>
                            <field name="is_log_enabled"/>
                            <field name="document_import_initial_date"/>
                            <field name="field_contact_info_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kw_vchasno_kw_vchasno_key_action_window" model="ir.actions.act_window">
        <field name="name">Key</field>
        <field name="res_model">kw.vchasno.key</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem action="kw_vchasno_kw_vchasno_key_action_window" id="kw_vchasno_kw_vchasno_key_menu" name="Key" parent="kw_vchasno_setting_main_menu" sequence="200"/>

</odoo>
