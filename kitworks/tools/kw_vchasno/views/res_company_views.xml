<odoo>
    <record id="kw_vchasno_res_company_form" model="ir.ui.view">
        <field name="name">res.company.form (kw_vchasno)</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook>
                <page string="Vchasno Key">
                    <field name="kw_vchasno_key_ids" widget="one2many">
                        <list editable="top">
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="token" password="True"/>
                            <field name="is_log_enabled" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
