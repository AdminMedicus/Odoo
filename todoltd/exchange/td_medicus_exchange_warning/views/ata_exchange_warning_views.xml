<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_product_exchange_warning_list" model="ir.ui.view">
        <field name="name">product.product.exchange.warning.list</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//*[local-name()='list' or local-name()='tree']/field[1]" position="before">
                <field name="ata_exchange_warning_icon" widget="html" nolabel="1" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

