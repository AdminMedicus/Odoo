<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_form_td_refund_inherit" model="ir.ui.view">
        <field name="name">res.partner.td.refund.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='child_ids']//form//field[@name='mobile']" position="after">
                <field name="use_in_vendor_refund_report" 
                       invisible="type != 'contact' or not parent_id"
                       string="Use in Vendor Refund Report"/>
            </xpath>
        </field>
    </record>

</odoo>
