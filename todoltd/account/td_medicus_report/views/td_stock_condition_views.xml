<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_td_stock_condition_list" model="ir.ui.view">
        <field name="name">view.td.stock.condition.list</field>
        <field name="model">td.stock.condition</field>
        <field name="arch" type="xml">

            <list string="Stock Conditions" editable="bottom">
                <field name="name"/>
                <field name="description"/>
            </list>

        </field>
    </record>

    <record id="action_td_stock_condition" model="ir.actions.act_window">
        <field name="name">Stock Conditions</field>
        <field name="res_model">td.stock.condition</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_td_stock_condition_list"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new stock condition.
            </p>
        </field>
    </record>

    <menuitem id="td_menu_stock_condition" name="Stock Conditions" parent="stock.menu_warehouse_config"
        action="action_td_stock_condition" sequence="10"/>

</odoo>
