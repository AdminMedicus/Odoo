<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="td_medicus_paperformat" model="report.paperformat">
        <field name="name">Medicus Report Landscape</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">32</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True" />
    </record>

    <record id="action_report_wholesale_invoice_picking" model="ir.actions.report">
        <field name="name">Оптова накладна</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">td_medicus_report.report_wholesale_picking</field>
        <field name="report_file">td_medicus_report.report_wholesale_picking</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="domain" eval="[('picking_type_code', '=', 'outgoing')]"/>
        <field name="paperformat_id" ref="td_medicus_report.td_medicus_paperformat"/>
    </record>

    <record id="action_report_wholesale_invoice_invoice" model="ir.actions.report">
        <field name="name">Оптова накладна</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">td_medicus_report.report_wholesale_invoice</field>
        <field name="report_file">td_medicus_report.report_wholesale_invoice</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="domain" eval="[('move_type', '=', 'out_invoice')]"/>
        <field name="paperformat_id" ref="td_medicus_report.td_medicus_paperformat"/>
    </record>

</odoo>
