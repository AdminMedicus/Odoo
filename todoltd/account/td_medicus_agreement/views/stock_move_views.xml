<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_view_stock_move_operations" model="ir.ui.view">
        <field name="name">td.stock.move.operations.form.inherit</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="sale_order_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="td_view_stock_move_line_operation_tree" model="ir.ui.view">
        <field name="name">td.stock.move.line.list.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="td_uktzed_code_id"/>
            </xpath>
        </field>
    </record>
</odoo>
