<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="td_agreement_closing_reasons_action" model="ir.actions.act_window">
        <field name="name">Closing Reason</field>
        <field name="res_model">td.agreement.closing.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="td_agreement_lost_reasons_list" model="ir.ui.view">
        <field name="name">td.agreement.closing.reason.list</field>
        <field name="model">td.agreement.closing.reason</field>
        <field name="arch" type="xml">
            <list string="Closing Reason">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="td_agreement_closing_reasons_form" model="ir.ui.view">
        <field name="name">td.agreement.closing.reason.form</field>
        <field name="model">td.agreement.closing.reason</field>
        <field name="arch" type="xml">
            <form string="Closing Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="td_agreement_closing_reasons_menu_action"
        name="Closing Reason"
        parent="td_agreement.td_agreement_menu"
        action="td_agreement_closing_reasons_action"
        sequence="2"
    />
</odoo>
