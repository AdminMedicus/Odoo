<odoo>
    <record id="rule_user_no_write_confirm_finish" model="ir.rule">
        <field name="name">User cannot edit records with state confirm_finish</field>
        <field name="model_id" ref="td_medicus_1c_integration.model_td_tax_invoice"/>
        <field name="groups" eval="[(4, ref('td_medicus_1c_integration.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('state', '=', 'confirm_finish')]</field>
    </record>
</odoo>
