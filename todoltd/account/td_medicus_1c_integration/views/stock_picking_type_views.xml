<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_one_c_view_picking_type_form" model="ir.ui.view">
        <field name="name">td.stock.picking.type.form.inherit</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="td_type_of_trade"/>
                <field
                        name="td_auto_create_purchase_on_validate"
                        invisible="code != 'incoming'"
                />
            </xpath>
        </field>
    </record>
</odoo>
