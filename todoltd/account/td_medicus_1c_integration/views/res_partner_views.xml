<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_manager_view_partner_form" model="ir.ui.view">
        <field name="name">td.res.partner.form.inherit.manager</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_payment_term_id']" position="before">
                <field name="td_manager_id"/>
            </xpath>
            <xpath expr="//group[@name='misc']//field[@name='company_registry']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="company_registry" invisible="parent_id" on_change="1"/>
            </xpath>
        </field>
    </record>
</odoo>
