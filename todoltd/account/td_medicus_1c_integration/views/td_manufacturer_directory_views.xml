<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_manufacturer_directory_view_form" model="ir.ui.view">
        <field name="name">td.manufacturer.directory.form</field>
        <field name="model">td.manufacturer.directory</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="full_name"/>
                        <field name="non_resident"/>
                        <field name="ukrainian_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="td_manufacturer_directory_view_tree" model="ir.ui.view">
        <field name="name">td.manufacturer.directory.form</field>
        <field name="model">td.manufacturer.directory</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" optional="show"/>
                <field name="name" optional="show"/>
                <field name="full_name" optional="show"/>
                <field name="non_resident" optional="show"/>
                <field name="ukrainian_name" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_td_manufacturer_directory" model="ir.actions.act_window">
        <field name="name">Manufacturer Directory</field>
        <field name="res_model">td.manufacturer.directory</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_td_manufacturer_directory"
        action="action_td_manufacturer_directory"
        parent="stock.menu_product_in_config_stock"
        sequence="5"
    />

</odoo>
