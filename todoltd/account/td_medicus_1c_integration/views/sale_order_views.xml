<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_one_c_integration_view_order_form_inherited" model="ir.ui.view">
        <field name="name">td.one.c.sale.order.form.inherited</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="attributes">
                <attribute name="options">"{'no_open': True, 'no_create': True, 'no_create_edit': True}"</attribute>
                <attribute name="can_create">0</attribute>
                <attribute name="context">
                    {
                      'no_create': True,
                      'no_create_edit': True,
                      'no_open': True,
                      'disable_quick_create': True
                    }
                </attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='product_template_id']" position="attributes">
                <attribute name="options">"{'no_open': True, 'no_create': True, 'no_create_edit': True}"</attribute>
                <attribute name="can_create">0</attribute>
                <attribute name="context">
                    {
                      'no_create': True,
                      'no_create_edit': True,
                      'no_open': True,
                      'disable_quick_create': True
                    }
                </attribute>
            </xpath>
            <xpath expr="//field[@name='name' and @widget='sol_text']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_tax_invoices"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        type="object"
                >
                    <field name="td_tax_invoice_count" widget="statinfo" string="Td Tax Invoices"/>
                </button>
            </xpath>
            <xpath expr="//button[@name='action_confirm']" position="replace">
            </xpath>
            <xpath expr="//button[@name='action_confirm']" position="replace">
            </xpath>
            <xpath expr="//button[@id='create_invoice']" position="replace">
                <field name="td_show_create_invoice" invisible="1"/>
                <button name="action_confirm" data-hotkey="q"
                        string="Confirm" class="btn-primary" type="object" context="{'validate_analytic': True}"
                        invisible="state != 'draft'"/>
                <button id="create_invoice" name="%(sale.action_view_sale_advance_payment_inv)d" string="Create Invoice"
                        type="action" class="btn-primary" data-hotkey="q"
                        invisible="invoice_status != 'to invoice' or td_show_create_invoice"/>
            </xpath>
        </field>
    </record>

    <record id="td_one_c_integration_view_order_form_td_inherited" model="ir.ui.view">
        <field name="name">td.one.c.sale.order.form.inherited</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="td_medicus_agreement.td_sale_order_implementation_document_form_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='implementation_document']" position="after">
                <field name="td_tax_guide_id"/>
                <field name="td_budget_funds"/>
            </xpath>
        </field>
    </record>

    <record id="td_one_c_view_quotation_tree_with_onboarding_inherit" model="ir.ui.view">
        <field name="name">td.sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="td_tax_invoice_state" optional="show" widget="badge"
                    decoration-muted="td_tax_invoice_state in ('budget', 'draft')"
                    decoration-info="td_tax_invoice_state == 'not_created'"
                    decoration-danger="td_tax_invoice_state == 'cancel'"
                    decoration-warning="td_tax_invoice_state == 'confirm'"
                    decoration-success="td_tax_invoice_state == 'confirm_finish'"
                />
                <field name="td_tax_invoice_state_percentage" optional="show"/>
                <field name="td_budget_funds" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

