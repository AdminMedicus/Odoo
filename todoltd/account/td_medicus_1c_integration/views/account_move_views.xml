<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_one_c_integration_account_move_form_inherited" model="ir.ui.view">
        <field name="name">td.one.c.account.move.form.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//button[@name='button_draft']" position="after">
                <field name="td_tax_invoice_id" invisible="1"/>
                <field name="td_tax_invoice_ids" invisible="1"/>
                <button name="action_create_td_tax_invoice" 
                        type="object" 
                        string="Create Td Tax Invoice" 
                        invisible="td_tax_invoice_id or state != 'posted' or td_budget_funds"
                        class="btn btn-secondary"/>
            </xpath>

            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_td_tax_invoice"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        type="object"
                        invisible="not td_tax_invoice_id or td_advance_payment_method != 'delivered'">
                    <div class="o_stat_info">
                        <field name="td_tax_invoice_name" readonly="1" nolabel="1" class="o_stat_text"/>
                        <span class="o_stat_text">Tax Invoice</span>
                    </div>
                </button>
                <button name="action_open_td_tax_invoice"
                        class="oe_stat_button"
                        icon="fa-list"
                        type="object"
                        invisible="not td_tax_invoice_ids or td_advance_payment_method not in ('percentage', 'fixed')">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Tax Invoices</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//label[@for='journal_id']" position="before">
                <field name="td_tax_guide_id" string="Tax Guide (1C)"/>
                <field name="td_budget_funds" string="Budget Funds Status"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='tax_ids']" position="after">
                <field name="td_purchase_price" optional="show" string="Purchase Price"/>
                <field name="td_margin" optional="show" string="Margin"/>
                <field name="td_margin_percent" optional="show" widget="percentage"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='price_subtotal']" position="before">
                <field name="td_paid_price" 
                       optional="show" 
                       column_invisible="parent.td_advance_payment_method != 'delivered'"
                       string="Paid Amount"/>
            </xpath>

            <xpath expr="//group[hasclass('oe_subtotal_footer')]" position="replace">
                <group class="oe_subtotal_footer"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or payment_state == 'invoicing_legacy'">

                    <field name="td_paid_invoice" invisible="1"/>

                    <field name="tax_totals" 
                           widget="account-tax-totals-field" 
                           nolabel="1" 
                           colspan="2"
                           readonly="state != 'draft' or (move_type not in ('in_invoice', 'in_refund', 'in_receipt') and not quick_edit_mode)"
                           invisible="td_paid_invoice"/>

                    <field name="td_tax_totals" 
                           widget="account-tax-totals-field" 
                           nolabel="1" 
                           colspan="2"
                           string="Paid Totals"
                           readonly="state != 'draft' or (move_type not in ('in_invoice', 'in_refund', 'in_receipt') and not quick_edit_mode)"
                           invisible="not td_paid_invoice"/>

                    <field name="invoice_payments_widget" colspan="2" nolabel="1" widget="payment"/>
                    <field name="amount_residual" class="oe_subtotal_footer_separator" invisible="state == 'draft'"/>

                    <field name="invoice_outstanding_credits_debits_widget"
                           class="oe_invoice_outstanding_credits_debits py-3"
                           colspan="2" 
                           nolabel="1" 
                           widget="payment"
                           invisible="state != 'posted' or not invoice_has_outstanding"/>
                </group>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_secondary_btn']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>