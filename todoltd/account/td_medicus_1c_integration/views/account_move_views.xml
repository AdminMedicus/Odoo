<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_one_c_integration_account_move_form_inherited" model="ir.ui.view">
        <field name="name">td.one.c.account.move.form.inherited</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field invisible="not td_order_id" name="td_order_id" readonly="1"/>
            </xpath>

            <xpath expr="//button[@name='button_draft']" position="after">
                <field name="td_tax_invoice_id" invisible="1"/>
                <field name="td_tax_invoice_ids" invisible="1"/>
                <button invisible="td_tax_invoice_id or state != 'posted' or td_budget_funds" name="action_create_td_tax_invoice" string="Create Td Tax Invoice" type="object"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="not td_tax_invoice_id or td_advance_payment_method != 'delivered'"
                        name="action_open_td_tax_invoice"
                        type="object"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text"><field name="td_tax_invoice_name" nolabel="1" readonly="1"/></span>
                    </div>
                </button>
                <button class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="not td_tax_invoice_ids or td_advance_payment_method not in ('percentage', 'fixed')"
                        name="action_open_td_tax_invoice"
                        type="object"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Tax Invoices</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//label[@for='journal_id']" position="before">
                <field name="td_tax_guide_id"/>
                <field name="td_budget_funds"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='tax_ids']" position="after">
                <field name="td_purchase_price" optional="show"/>
                <field name="td_margin" optional="show"/>
                <field name="td_margin_percent" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='price_subtotal']" position="before">
                <field column_invisible="parent.td_advance_payment_method != 'delivered'" name="td_paid_price" optional="show"/>
            </xpath>
            <xpath expr="//group[hasclass('oe_subtotal_footer')]" position="replace">
                <group class="oe_subtotal_footer"
                    invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or payment_state == 'invoicing_legacy'">

                    <field invisible="1" name="td_paid_invoice"/>

                    <field colspan="2" invisible="td_paid_invoice" name="tax_totals" nolabel="1"
                           readonly="state != 'draft' or (move_type not in ('in_invoice', 'in_refund', 'in_receipt') and not quick_edit_mode)"
                           widget="account-tax-totals-field"
                    />
                    <field colspan="2" invisible="not td_paid_invoice" name="td_tax_totals" nolabel="1"
                           readonly="state != 'draft' or (move_type not in ('in_invoice', 'in_refund', 'in_receipt') and not quick_edit_mode)"
                           widget="account-tax-totals-field"
                    />

                    <field colspan="2" name="invoice_payments_widget" nolabel="1" widget="payment"/>
                    <field class="oe_subtotal_footer_separator" invisible="state == 'draft'" name="amount_residual"/>
                </group>
                <field class="oe_invoice_outstanding_credits_debits py-3"
                    colspan="2" invisible="state != 'posted' or not invoice_has_outstanding" name="invoice_outstanding_credits_debits_widget" nolabel="1" widget="payment"/>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_secondary_btn']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
