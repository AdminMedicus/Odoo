<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_one_c_view_picking_form_inherited" model="ir.ui.view">
        <field name="name">td.stock_picking_batch.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="td_medicus_agreement.td_implementation_document_view_picking_form_inherit"/>
        <field name="priority" eval="1000"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="td_is_import" invisible="1"/>
                <field name="td_currency_id" invisible="not td_is_import"/>
                <field name="td_currency_rate" invisible="not td_is_import"/>
            </xpath>

            <xpath expr="//field[@name='owner_id']" position="after">
                <field name="picking_code" invisible="1"/>
                <field name="td_auto_create_purchase_on_validate" invisible="1"/>
                <field name="td_is_goods_balance_of_act_res_st" invisible="1"/>
                <field name="td_type_of_trade" invisible="picking_code" readonly="picking_type_code != 'incoming'"/>
                <field
                        name="td_agreement_id"
                        invisible="picking_type_code != 'incoming' or not td_auto_create_purchase_on_validate"
                        domain="[('partner_id', '=?', partner_id)]"
                        context="{'default_partner_id': partner_id}"
                />
            </xpath>

            <xpath expr="//field[@name='picking_type_id']" position="before">
                <field name="td_supplier_document" invisible="picking_code"/>
                <field name="td_date_supplier_document" invisible="picking_code"/>
            </xpath>

            <!--
                Import columns used to be anchored on td_uktzed_code_id, which is now the last
                column of the list. They are grouped with the other amount columns instead.
            -->
<!--            <xpath expr="//field[@name='move_ids_without_package']//field[@name='td_uktzed_code_id']" position="after">-->
<!--                <field name="td_currency_rate" optional="show" column_invisible="not parent.td_is_import"/>-->
<!--                <field-->
<!--                        name="td_customs_rate"-->
<!--                        optional="show"-->
<!--                        widget="percentage"-->
<!--                        column_invisible="not parent.td_is_import"-->
<!--                />-->
<!--            </xpath>-->

            <xpath expr="//field[@name='move_ids_without_package']//field[@name='td_price_subtotal']" position="after">
                <field
                        name="td_currency_rate"
                        optional="show"
                        width="110px"
                        column_invisible="not parent.td_is_import"
                />
                <field
                        name="td_customs_rate"
                        optional="show"
                        widget="percentage"
                        width="110px"
                        column_invisible="not parent.td_is_import"
                />
                <field
                        name="td_customs_value_good"
                        optional="show"
                        width="130px"
                        column_invisible="not parent.td_is_import"
                />
                <field
                        name="td_book_value"
                        optional="show"
                        width="120px"
                        column_invisible="not parent.td_is_import"
                />
                <field name="td_taxes_ids" widget="many2many_tags" optional="show" width="150px"/>
                <!--                <field name="td_taxes" optional="show" widget="percentage" readonly="1"/>-->
                <field name="td_taxes_price" optional="show" readonly="1" width="110px"/>
                <field name="td_price_total" optional="show" readonly="1" width="120px"/>
            </xpath>

            <!-- Prepared button for import pickings -->
            <xpath expr="//button[@name='button_validate' and contains(@class, 'oe_highlight')]" position="before">
                <button
                        name="td_button_send_data_to_one_c"
                        type="object"
                        class="btn btn-primary"
                        data-hotkey="v"
                        string="Prepared"
                        invisible="not td_is_import or state not in ('assigned', 'confirmed')"
                />
            </xpath>

            <!-- Standard highlighted Validate button -->
            <xpath expr="//button[@name='button_validate' and contains(@class, 'oe_highlight')]" position="attributes">
                <attribute name="invisible">
                    td_is_import or state in ('draft', 'confirmed', 'done', 'cancel')
                </attribute>
            </xpath>

            <!-- Secondary Validate button -->
            <xpath expr="//button[@name='button_validate' and contains(@class, 'o_btn_validate')]"
                   position="attributes">
                <attribute name="invisible">
                    td_is_import or state in ('waiting', 'assigned', 'done', 'cancel') or picking_type_code=='internal'
                </attribute>
            </xpath>

            <xpath expr="//field[@name='state']" position="replace">
                <field
                        name="state"
                        widget="statusbar"
                        invisible="picking_type_code != 'incoming' or td_is_import"
                        statusbar_visible="draft,assigned,done"
                />
                <field
                        name="state"
                        widget="statusbar"
                        invisible="picking_type_code != 'incoming' or not td_is_import"
                        statusbar_visible="draft,assigned,done,import"
                />
            </xpath>

            <xpath expr="//field[@name='td_total_amount']" position="before">
                <field name="td_company_currency_id" invisible="1"/>
                <field name="td_amount_origin_currency"/>
                <field name="td_total_without_tax"/>
                <field name="td_total_tax"/>
            </xpath>


            <xpath expr="//field[@name='implementation_document']" position="attributes">
                <attribute name="invisible">picking_type_code == 'incoming'</attribute>
            </xpath>

            <xpath expr="//button[@name='action_show_product_list']" position="attributes">
                <attribute name="invisible">state not in ('draft') or not td_is_goods_balance_of_act_res_st</attribute>
            </xpath>

            <xpath expr="//field[@name='date_agreement_start']" position="attributes">
                <attribute name="invisible">not td_is_goods_balance_of_act_res_st</attribute>
            </xpath>

            <xpath expr="//label[@for='date_agreement_start']" position="attributes">
                <attribute name="invisible">not td_is_goods_balance_of_act_res_st</attribute>
            </xpath>

            <xpath expr="//field[@name='date_agreement_end']" position="attributes">
                <attribute name="invisible">not td_is_goods_balance_of_act_res_st</attribute>
            </xpath>

            <xpath expr="//label[@for='date_agreement_end']" position="attributes">
                <attribute name="invisible">not td_is_goods_balance_of_act_res_st</attribute>
            </xpath>

            <xpath expr="//button[@name='create_implementation_document_sale_order']" position="attributes">
                <attribute name="invisible">sale_id or not td_is_goods_balance_of_act_res_st</attribute>
            </xpath>
        </field>
    </record>

    <record id="td_one_c_view_picking_form_hide_parent_partner" model="ir.ui.view">
        <field name="name">td.stock.picking.form.hide.parent.partner</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="td_contact_sale.view_picking_form_td_sub_client_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='td_parent_partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
