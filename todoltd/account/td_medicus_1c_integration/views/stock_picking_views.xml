<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_one_c_view_picking_form_inherited" model="ir.ui.view">
        <field name="name">td.stock_picking_batch.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="td_medicus_agreement.td_implementation_document_view_picking_form_inherit"/>
        <field name="priority" eval="1000"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="td_is_import" invisible="1"/>
                <field name="td_currency_id" invisible="not td_is_import"/>
                <field name="td_currency_rate" invisible="not td_is_import"/>
            </xpath>
            <xpath expr="//field[@name='owner_id']" position="after">
                <field name="picking_code" invisible="1"/>
                <field name="td_type_of_trade" invisible="picking_code"/>
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="before">
                <field name="td_supplier_document" invisible="picking_code"/>
                <field name="td_date_supplier_document" invisible="picking_code"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='td_uktzed_code_id']" position="after">
                <field name="td_currency_rate" optional="show" column_invisible="not parent.td_is_import"/>
                <field name="td_customs_rate" optional="show" widget="percentage" column_invisible="not parent.td_is_import"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']//field[@name='td_price_subtotal']" position="after">
                <field name="td_customs_value_good" optional="show" column_invisible="not parent.td_is_import"/>
                <field name="td_book_value" optional="show" column_invisible="not parent.td_is_import"/>
<!--                <field name="td_taxes" optional="show" widget="percentage" column_invisible="not parent.td_is_import"/>-->
                <field name="td_taxes" optional="show" widget="percentage" />
                <field name="td_taxes_price" optional="show"/>
<!--                <field name="td_taxes_price" optional="show" column_invisible="not parent.td_is_import"/>-->
<!--                <field name="td_price_total" optional="show" column_invisible="not parent.td_is_import"/>-->
                <field name="td_price_total" optional="show"/>
            </xpath>
            <xpath expr="//button[@name='button_validate']" position="before">
<!--                <button name="td_button_send_data_to_one_c" invisible="not td_is_import" string="Send data to 1C" type="object" class="btn btn-primary" data-hotkey="v"/>-->
                <button
                    name="td_button_send_data_to_one_c"
                    type="object"
                    class="btn btn-primary"
                    data-hotkey="v"
                    string="Prepared"
                    invisible="not td_is_import or state in ('import','done','cancel')"
                />
            </xpath>

            <xpath expr="//button[@name='button_validate']" position="replace">
                <button
                    name="button_validate"
                    type="object"
                    class="btn btn-primary"
                    string="Confirm"
                    invisible="td_is_import or state not in ('assigned','confirmed')"
                />

                <button
                    name="button_validate"
                    type="object"
                    class="btn btn-primary"
                    string="Confirm"
                    invisible="not td_is_import or state in ('import','done','cancel') or state not in ('assigned','confirmed')"
                />
            </xpath>

            <xpath expr="//field[@name='state']" position="replace">
                <field name="state" widget="statusbar" invisible="picking_type_code != 'incoming' or td_is_import" statusbar_visible="draft,assigned,done"/>
                <field name="state" widget="statusbar" invisible="picking_type_code != 'incoming' or not td_is_import" statusbar_visible="draft,assigned,done,import"/>
            </xpath>
            <xpath expr="//field[@name='td_total_amount']" position="before">
                <field name="td_company_currency_id" invisible="1"/>
                <field name="td_amount_origin_currency"/>
                <field name="td_total_without_tax"/>
                <field name="td_total_tax"/>
            </xpath>
        </field>
    </record>
</odoo>