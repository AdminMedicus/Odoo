<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_product_normal_form_view_td_medicus_1c_integration_inherit_from" model="ir.ui.view">
        <field name="name">product.product.td_medicus_1c_integration.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
<!--                <field name="td_manufacturer_directory_id"/>-->
                <field name="td_manufacturer_directory_res_id"/>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="td_one_c_category_id" context="{'search_default_td_leaf_category': 1, 'category_leaf_only': 1}"/>
            </xpath>
        </field>
    </record>
</odoo>