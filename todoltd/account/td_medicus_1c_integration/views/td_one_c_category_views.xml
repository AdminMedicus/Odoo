<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_td_one_c_category_view_form" model="ir.ui.view">
        <field name="name">td.one_c.category.form</field>
        <field name="model">td.one_c.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                        <field name="code"/>
                        <field name="child_ids" nolabel="1">
                            <list>
                                <field name="name" optional="show"/>
                                <field name="parent_id" optional="show"/>
                                <field name="code" optional="show"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="td_td_one_c_category_view_search" model="ir.ui.view">
        <field name="name">td.one_c.category.search</field>
        <field name="model">td.one_c.category</field>
        <field name="arch" type="xml">
            <search>
                <filter name="td_leaf_category" string="Leaves only" domain="[('child_ids', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="td_td_one_c_category_view_tree" model="ir.ui.view">
        <field name="name">td.one_c.category.form</field>
        <field name="model">td.one_c.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" optional="show"/>
                <field name="parent_id" optional="show"/>
                <field name="code" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_td_one_c_category" model="ir.actions.act_window">
        <field name="name">Category 1C</field>
        <field name="res_model">td.one_c.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_td_one_c_category"
        action="action_td_one_c_category"
        parent="stock.menu_product_in_config_stock"
        sequence="1"
    />

</odoo>
