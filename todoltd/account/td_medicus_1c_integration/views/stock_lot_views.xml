<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="td_view_production_lot_form_import_qty" model="ir.ui.view">
        <field name="name">td.view.lot.form.import.qty</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="td_medicus_uktzed.td_view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='td_uktzed_code_id']" position="after">
                <field name="product_qty" readonly="1"/>
                <field name="td_available_qty" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>