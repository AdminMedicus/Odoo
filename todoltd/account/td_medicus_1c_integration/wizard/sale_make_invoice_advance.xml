<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="td_view_sale_advance_payment_inv" model="ir.ui.view">
        <field name="name">td.sale.advance.payment.inv.form.inherit</field>
        <field name="model">sale.advance.payment.inv</field>
        <field name="inherit_id" ref="sale.view_sale_advance_payment_inv"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='advance_payment_method']" position="attributes">
               <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//div[@id='payment_method_details']" position="attributes">
               <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='advance_payment_method']" position="before">
                <field name="td_choose_payment_method" invisible="1"/>
                <field name="td_payment_method" invisible="1"/>
                <field name="td_advance_payment_method" class="oe_inline"
                       widget="radio"
                       invisible="count &gt; 1 or not td_choose_payment_method"
                       required="True"
                />
                <field name="td_advance_payment_method_one" class="oe_inline"
                       widget="radio"
                       invisible="count &gt; 1 or td_choose_payment_method"
                       required="True"
                />
            </xpath>

        </field>
    </record>
</odoo>
