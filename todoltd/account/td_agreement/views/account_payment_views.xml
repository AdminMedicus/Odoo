<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="td_account_payment_form_inherited" model="ir.ui.view">
        <field name="name">td.account.payment.form.inherited</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="td_agreement_id_domain" invisible="True"/>
                <field name="td_agreement_id" domain="td_agreement_id_domain"/>
            </xpath>
        </field>
    </record>
</data></odoo>
