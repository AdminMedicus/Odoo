<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="td_agreement_types_action" model="ir.actions.act_window">
		<field name="name">Types of Agreements</field>
		<field name="res_model">td.agreement.types</field>
		<field name="view_mode">list,form</field>
	</record>

	<record id="td_agreement_types_list" model="ir.ui.view">
		<field name="name">td.agreement.types.list</field>
		<field name="model">td.agreement.types</field>
		<field name="arch" type="xml">
			<list string="Types of Agreements">
				<field name="sequence" widget="handle"/>
				<field name="name"/>
				<field name="td_type" />
			</list>
		</field>
	</record>

	<record id="td_agreement_types_view_form" model="ir.ui.view">
		<field name="name">td.print.type.group.form</field>
		<field name="model">td.agreement.types</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<div class="oe_title">
						<label for="name"/>
						<h1>
							<field name="name" placeholder="Type name" required="true"/>
						</h1>
					</div>
					<group>
						<field name="td_type" placeholder="Type of agreement" required="true"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<menuitem
		id="td_agreement_types_menu_action"
		parent="td_agreement.td_agreement_menu"
		action="td_agreement.td_agreement_types_action"
		sequence="1"/>

</odoo>
