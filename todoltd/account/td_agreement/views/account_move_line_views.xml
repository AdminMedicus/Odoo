<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="td_account_move_line_tree_inherited" model="ir.ui.view">
        <field name="name">td.account.move.line.tree.inherited</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="td_agreement_id" optional="show" readonly="move_type != 'entry'"/>
            </xpath>
        </field>
    </record>
</data></odoo>
