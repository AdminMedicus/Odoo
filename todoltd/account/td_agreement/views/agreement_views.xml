<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- VIEWS -->
	<record id="td_agreement_tree" model="ir.ui.view">
		<field name="name">td.agreement.tree</field>
		<field name="model">td.agreement</field>
		<field name="priority">1000</field>
		<field name="arch" type="xml">
			<list>
				<field name="id" string="Internal Number" />
				<field name="name"/>
				<field name="signing_date"/>
				<field name="start_date"/>
				<field name="end_date"/>
				<field name="company_id"/>
				<field name="partner_id"/>
				<field name="currency_id"/>
				<field name="account_id"/>
			</list>
		</field>
	</record>


	<record id="td_agreement_form" model="ir.ui.view">
		<field name="name">td.agreement.form</field>
		<field name="model">td.agreement</field>
		<field name="priority">1000</field>
		<field name="arch" type="xml">
			<form>
				<sheet string="Agreement">
					<group>
						<group>
							<field name="name"/>
							<field name="number"/>
							<field name="id" string="Internal Number" />
							<field name="company_id"/>
							<field name="partner_id"/>
						</group>
						<group>
							<group>
								<field name="signing_date"/>
							</group>
							<group class="o_row">
								<field name="start_date"/>
								<field name="end_date"/>
							</group>
							<group>
								<field name="agreement_type" invisible="1"/>
								<field name="type_of_agreement"/>
							</group>
						</group>
					</group>
					<notebook>
						<page string="Description" name="description">
							<group>
								<field name="currency_id"/>
								<field name="account_id_domain" invisible="True"/>
								<field name="account_id" domain="account_id_domain"/>
							</group>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<!-- ACTIONS (WINDOW) -->
	<record id="td_action_agreement_view_tree" model="ir.actions.act_window">
		<field name="name">Agreements</field>
		<field name="res_model">td.agreement</field>
		<field name="view_mode">list,form</field>
	</record>

	<!-- MENU -->
	<menuitem id="menu_td_agreements" name="Agreements"
			  parent="td_agreement.menu_td_agreement_root" sequence="1"
			  action="td_agreement.td_action_agreement_view_tree"/>


</odoo>
