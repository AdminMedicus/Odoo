<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_td_service_report" model="ir.actions.report">
        <field name="name">Сервісний звіт</field>
        <field name="model">td.service.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">td_medicus_service_report.report_td_service_report</field>
        <field name="report_file">td_medicus_service_report.report_td_service_report</field>
        <field name="binding_model_id" ref="model_td_service_report"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id"
               ref="td_medicus_service_report.td_service_report_paperformat"/>
        <field name="print_report_name">'Сервісний звіт %s - %s' % (object.sequence_number, (object.ticket_id.name or '').replace('/', '-'))</field>
    </record>

</odoo>
