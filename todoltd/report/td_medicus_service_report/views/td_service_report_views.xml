<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Service report form: used both as a standalone form and as   -->
    <!-- the wizard-like dialog opened from the ticket.               -->
    <!-- ============================================================ -->
    <record id="view_td_service_report_form" model="ir.ui.view">
        <field name="name">td.service.report.form</field>
        <field name="model">td.service.report</field>
        <field name="arch" type="xml">
            <form string="Service Report">
                <header>
                    <button name="action_print_report"
                            string="Generate Report"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_apply_warranty_suggestion"
                            string="Apply System Suggestion"
                            type="object"
                            class="btn-secondary"
                            invisible="not td_warranty_suggestion"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group name="ticket_data">
                            <field name="ticket_id" readonly="id" options="{'no_open': True}"/>
                            <field name="partner_id" readonly="1" options="{'no_open': True}"/>
                            <field name="td_lot_id" options="{'no_create': True}"/>
                            <field name="td_product_id" readonly="1" options="{'no_open': True}"/>
                            <field name="td_equipment_address"
                                   placeholder="Address the equipment is installed at..."/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group name="header_data">
                            <field name="td_date_report"/>
                            <field name="td_service_hours"/>
                            <field name="td_engineer_id" options="{'no_create': True}"/>
                            <field name="td_agreement_domain" invisible="1"/>
                            <field name="td_agreement_ids"
                                   widget="many2many_tags"
                                   domain="td_agreement_domain"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group string="Warranty Information" name="warranty_info"
                           invisible="not td_lot_id">
                        <group>
                            <field name="td_warranty_suggestion" readonly="1"/>
                        </group>
                        <group>
                            <field name="td_warranty_date_end_manufacturer" readonly="1"/>
                            <field name="td_warranty_date_end_company" readonly="1"/>
                        </group>
                    </group>

                    <group string="Service Category" name="categories">
                        <group>
                            <field name="td_is_delivery"/>
                            <field name="td_is_installation"/>
                            <field name="td_is_repair"/>
                        </group>
                        <group>
                            <field name="td_is_maintenance"/>
                            <field name="td_is_demonstration"/>
                            <field name="td_is_inspection"/>
                        </group>
                        <field name="td_category_summary" invisible="1"/>
                        <field name="td_has_category" invisible="1"/>
                    </group>

                    <!-- 3.3. Delivery -->
                    <group string="Delivery" name="block_delivery"
                           invisible="not td_is_delivery">
                        <field name="td_delivery_info" nolabel="1" colspan="2"
                               placeholder="Delivery information..."/>
                    </group>

                    <!-- 3.4. Installation -->
                    <group string="Installation" name="block_installation"
                           invisible="not td_is_installation">
                        <field name="td_installation_info" nolabel="1" colspan="2"
                               placeholder="Installation information..."/>
                    </group>

                    <!-- 3.5. Repair / technical maintenance -->
                    <group string="Repair / Technical Maintenance" name="block_repair"
                           invisible="not td_is_repair">
                        <field name="td_repair_warranty_type" widget="radio"
                               options="{'horizontal': True}"/>
                        <field name="td_repair_order_id"
                               domain="[('ticket_id', '=', ticket_id)]"
                               options="{'no_create': True}"/>
                        <field name="td_repair_works" placeholder="Works performed..."/>
                        <field name="td_repair_comments" placeholder="Comments / results..."/>
                    </group>

                    <!-- 3.6. Maintenance / setup -->
                    <group string="Maintenance / Setup" name="block_maintenance"
                           invisible="not td_is_maintenance">
                        <field name="td_maintenance_warranty_type" widget="radio"
                               options="{'horizontal': True}"/>
                        <field name="td_maintenance_description" placeholder="Description..."/>
                        <field name="td_maintenance_works" placeholder="Works performed..."/>
                        <field name="td_maintenance_comments" placeholder="Comments / results..."/>
                    </group>

                    <!-- 3.6. Demonstration / consulting -->
                    <group string="Demonstration / Consulting" name="block_demonstration"
                           invisible="not td_is_demonstration">
                        <field name="td_demonstration_warranty_type" widget="radio"
                               options="{'horizontal': True}"/>
                        <field name="td_demonstration_description" placeholder="Description..."/>
                        <field name="td_demonstration_works" placeholder="Works performed..."/>
                        <field name="td_demonstration_comments" placeholder="Comments / results..."/>
                    </group>

                    <!-- 3.7. Equipment inspection on call / removal for repair -->
                    <group string="Equipment Inspection on Call / Removal for Repair"
                           name="block_inspection"
                           invisible="not td_is_inspection">
                        <field name="td_inspection_warranty_type" widget="radio"
                               options="{'horizontal': True}"/>
                        <field name="td_inspection_defect" placeholder="Defect description..."/>
                        <field name="td_inspection_works" placeholder="Works performed..."/>
                        <field name="td_inspection_comments" placeholder="Comments / results..."/>
                        <field name="td_inspection_damage" widget="radio"
                               options="{'horizontal': True}"/>
                        <field name="td_inspection_damage_description"
                               invisible="td_inspection_damage != 'present'"
                               placeholder="Describe the visible damage..."/>
                        <field name="td_inspection_warranty_card_marked"/>
                        <field name="td_inspection_equipment_set"
                               placeholder="Equipment RECEIVED for repair together with (set)..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Service report list (multiline tab on the ticket)            -->
    <!-- ============================================================ -->
    <record id="view_td_service_report_list" model="ir.ui.view">
        <field name="name">td.service.report.list</field>
        <field name="model">td.service.report</field>
        <field name="arch" type="xml">
            <list string="Service Reports">
                <field name="sequence_number" string="#" optional="show"/>
                <field name="name"/>
                <field name="td_date_report"/>
                <field name="td_category_summary"/>
                <field name="td_service_hours" optional="show"/>
                <field name="td_lot_id" optional="hide"/>
                <field name="td_engineer_id" optional="hide"/>
                <button name="action_print_report"
                        type="object"
                        icon="fa-print"
                        title="Generate Report"/>
            </list>
        </field>
    </record>

    <record id="view_td_service_report_search" model="ir.ui.view">
        <field name="name">td.service.report.search</field>
        <field name="model">td.service.report</field>
        <field name="arch" type="xml">
            <search string="Search Service Reports">
                <field name="ticket_id"/>
                <field name="partner_id"/>
                <field name="td_lot_id"/>
                <field name="td_engineer_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_ticket" string="Ticket"
                            context="{'group_by': 'ticket_id'}"/>
                    <filter name="group_partner" string="Customer"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Preparation Date"
                            context="{'group_by': 'td_date_report'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_td_service_report" model="ir.actions.act_window">
        <field name="name">Service Reports</field>
        <field name="res_model">td.service.report</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
