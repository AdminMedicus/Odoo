<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <record id="view_td_warranty_link_wizard_form" model="ir.ui.view">
        <field name="name">td.warranty.link.wizard.form</field>
        <field name="model">td.warranty.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Link Warranty to Serial Number">
                <group>
                    <field name="sale_order_line_id" invisible="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="available_serial_ids" invisible="1"/>
                    <field name="filter_by_customer"/>
                    <field name="search_serial"/>
                    <field name="serial_id" domain="[('id', 'in', available_serial_ids)]"/>
                </group>
                <footer>
                    <button string="Link" name="action_link_serial" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
