<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Stock Picking Form View Extension -->
    <record id="view_picking_form_td_warranty_extend" model="ir.ui.view">
        <field name="name">stock.picking.form.td.warranty</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_infos']" position="inside">
                <field name="td_date_commissioning"/>
            </xpath>
        </field>
    </record>
    
</odoo>