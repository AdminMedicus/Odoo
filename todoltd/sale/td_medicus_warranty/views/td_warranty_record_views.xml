<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- Warranty Record List View -->
    <record id="view_td_warranty_record_list" model="ir.ui.view">
        <field name="name">td.warranty.record.list</field>
        <field name="model">td.warranty.record</field>
        <field name="arch" type="xml">
            <list string="Warranties" decoration-muted="status == 'expired'">
                <field name="name"/>
                <field name="serial_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="warranty_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration_months"/>
                <field name="status" decoration-success="status == 'active'" decoration-muted="status == 'expired'"/>
            </list>
        </field>
    </record>

    <!-- Warranty Record Form View -->
    <record id="view_td_warranty_record_form" model="ir.ui.view">
        <field name="name">td.warranty.record.form</field>
        <field name="model">td.warranty.record</field>
        <field name="arch" type="xml">
            <form string="Warranty">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="active,expired"/>
                    <button name="action_set_active" type="object" string="Set Active" invisible="status != 'draft'" class="oe_highlight"/>
                    <button name="action_set_draft" type="object" string="Set Draft" invisible="status == 'draft'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Add button boxes here if needed -->
                    </div>
                    <group>
                        <group>
                            <field name="warranty_type" readonly="status != 'draft'"/>
                            <field name="serial_id" options="{'no_create': True}" readonly="status != 'draft'"/>
                            <field name="product_id"/>
                            <field name="partner_id" readonly="status != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="status != 'draft'"/>
                            <field name="date_end"/>
                            <field name="duration_months" readonly="status != 'draft'"/>
                        </group>
                    </group>
                    <group string="Extended Warranty Details" invisible="warranty_type != 'extended'">
                        <field name="sale_order_id" readonly="status != 'draft'"/>
                        <field name="sale_order_line_id" readonly="status != 'draft'" domain="[('order_id', '=', sale_order_id)]"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Warranty Record Search View -->
    <record id="view_td_warranty_record_search" model="ir.ui.view">
        <field name="name">td.warranty.record.search</field>
        <field name="model">td.warranty.record</field>
        <field name="arch" type="xml">
            <search string="Search Warranties">
                <field name="name"/>
                <field name="serial_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                <filter string="Expired" name="expired" domain="[('status', '=', 'expired')]"/>
                <filter string="Manufacturer" name="manufacturer" domain="[('warranty_type', '=', 'manufacturer')]"/>
                <filter string="Extended" name="extended" domain="[('warranty_type', '=', 'extended')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'warranty_type'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Warranty Record Action -->
    <record id="action_td_warranty_record" model="ir.actions.act_window">
        <field name="name">Warranties</field>
        <field name="res_model">td.warranty.record</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No warranties found. They will be created automatically when warranty products are delivered.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
     <menuitem
        id="td_warranty_sale_menu_root"
        name="Warranty Records"
        parent="sale.product_menu_catalog"
        sequence="50"/>
     <menuitem
        id="td_warranty_records_sale_menu"
        name="Warranties"
        action="action_td_warranty_record"
        parent="td_warranty_sale_menu_root"/>
     <menuitem
        id="td_warranty_purchase_menu_root"
        name="Warranty Records"
        parent="purchase.menu_purchase_products"
        sequence="50"/>
     <menuitem
        id="td_warranty_records_purchase_menu"
        name="Warranties"
        action="action_td_warranty_record"
        parent="td_warranty_purchase_menu_root"/>
     <menuitem
        id="td_warranty_stock_menu_root"
        name="Warranty Records"
        parent="stock.menu_stock_inventory_control"
        sequence="50"/>
     <menuitem
        id="td_warranty_records_stock_menu"
        name="Warranties"
        action="action_td_warranty_record"
        parent="td_warranty_stock_menu_root"/>

</odoo>
