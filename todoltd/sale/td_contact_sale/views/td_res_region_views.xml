<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_country_region_tree" model="ir.ui.view">
        <field name="name">td.res.country.region.tree</field>
        <field name="model">td.res.country.region</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="parent_region_id"/>
            </list>
        </field>
    </record>

    <record id="td_view_country_region_search" model="ir.ui.view">
        <field name="name">td.res.country.region.search</field>
        <field name="model">td.res.country.region</field>
        <field name="arch" type="xml">
            <search>
                <filter name="td_leaf" string="Leaves only" domain="[('child_region_ids', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_country_region_form" model="ir.ui.view">
        <field name="name">td.res.country.region.form</field>
        <field name="model">td.res.country.region</field>
        <field name="arch" type="xml">
            <form string="Region">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_region_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_country_region" model="ir.actions.act_window">
        <field name="name">Region</field>
        <field name="res_model">td.res.country.region</field>
        <field name="view_id" ref="view_country_region_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Region
            </p>
        </field>
    </record>
</odoo>
