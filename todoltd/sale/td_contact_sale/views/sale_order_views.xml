<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_td_sub_client_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.td.sub.client</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="allowed_sub_client_ids" invisible="1"/>
                <field name="sub_client_id" domain="[('id', 'in', allowed_sub_client_ids)]" readonly="not partner_id or state in ('sale', 'cancel')"/>
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="replace">
                <field name="allowed_partner_shipping_id" invisible="1"/>
                <field name="partner_shipping_id"
                       groups="account.group_delivery_invoice_address"
                       context="{'default_type':'delivery', 'show_address': False, 'show_vat': False}"
                       readonly="state == 'cancel' or locked"
                       invisible="sub_client_id"
                />
                <field name="partner_shipping_id"
                       groups="account.group_delivery_invoice_address"
                       context="{'default_type':'delivery', 'show_address': False, 'show_vat': False}"
                       readonly="state == 'cancel' or locked"
                       domain="[('id', 'in', allowed_partner_shipping_id)]"
                       invisible="not sub_client_id"
                />
            </xpath>

        </field>
    </record>

    <record id="view_order_form_td_status_stock_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.td.sub.client</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="replace">
                <div class="oe_title oe_td_title">
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                    <field name="stock_status_assigned" invisible="1"/>
                    <div id="td_status_stock_button">
                        <button name="action_confirm_stock_status"
                            class="btn-primary"
                            string="Ready to be completed"
                            invisible="stock_status_assigned"
                            type="object" data-hotkey="g"
                        />
                        <button name="action_rejected_stock_status"
                            class="btn-secondary"
                            string="Not Ready to be completed"
                            invisible="not stock_status_assigned"
                            type="object" data-hotkey="g"
                        />
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_td_change_product_inherit" model="ir.ui.view">
        <field name="name">td.change.product.sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//list//field[@name='product_uom']" position="after">
                <button
                        class="btn fa fa-bars text-start o_external_button px-1"
                        name="action_change_product_in_line"
                        type="object" title="Change Product"
                />
            </xpath>
        </field>
    </record>

</odoo>
