<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="td_helpdesk_ticket_view_form_inherit" model="ir.ui.view">
        <field name="name">td.helpdesk.ticket.form.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet//group//field[@name='email_cc']" position="after">
                <field name="td_equipment_id" context="{'td_equipment_display': True}"/>
                <field name="td_serial_domain" invisible="True"/>
                <field name="td_serial_number_id" domain="td_serial_domain"/>
            </xpath>

        </field>
    </record>

    <record id="td_crm_helpdesk_ticket_view_form_inherit" model="ir.ui.view">
        <field name="name">td.crm.helpdesk.ticket.form.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="crm_helpdesk.helpdesk_ticket_view_form_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_convert_ticket_to_lead_or_opportunity'][1]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//button[@name='action_convert_ticket_to_lead_or_opportunity'][2]" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
        </field>
    </record>

    <record id="td_helpdesk_fsm_ticket_view_form_inherit" model="ir.ui.view">
        <field name="name">td.helpdesk.fsm.ticket.form.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_fsm.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_generate_fsm_task']" position="attributes">
                <attribute name="string">Schedule a departure</attribute>
            </xpath>
        </field>
    </record>


</odoo>