<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="td_equipment_applicant_view_form" model="ir.ui.view">
        <field name="name">td.equipment.applicant.form</field>
        <field name="model">td.equipment.applicant</field>
        <field name="arch" type="xml">
            <form string="Equipment Applicant">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="company_name" placeholder="Company name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="lot_id"/>
                            <field name="product_id"/>
                            <field name="edrpou"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="contact_name"/>
                            <field name="phone" widget="phone"/>
                            <field name="is_confirmed"/>
                            <field name="confirmed_uid" invisible="not is_confirmed"/>
                            <field name="confirmed_date" invisible="not is_confirmed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tickets" name="tickets">
                            <field name="ticket_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="stage_id"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="td_equipment_applicant_view_list" model="ir.ui.view">
        <field name="name">td.equipment.applicant.list</field>
        <field name="model">td.equipment.applicant</field>
        <field name="arch" type="xml">
            <list string="Equipment Applicants">
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="company_name"/>
                <field name="edrpou"/>
                <field name="partner_id" optional="show"/>
                <field name="contact_name" optional="hide"/>
                <field name="phone" optional="hide"/>
                <field name="ticket_count"/>
                <field name="is_confirmed"/>
            </list>
        </field>
    </record>

    <record id="td_equipment_applicant_view_search" model="ir.ui.view">
        <field name="name">td.equipment.applicant.search</field>
        <field name="model">td.equipment.applicant</field>
        <field name="arch" type="xml">
            <search string="Equipment Applicants">
                <field name="company_name"/>
                <field name="edrpou"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter string="Confirmed" name="confirmed" domain="[('is_confirmed', '=', True)]"/>
                <filter string="Not Confirmed" name="not_confirmed" domain="[('is_confirmed', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Serial Number" name="group_lot" context="{'group_by': 'lot_id'}"/>
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="td_equipment_applicant_action" model="ir.actions.act_window">
        <field name="name">Equipment Applicants</field>
        <field name="res_model">td.equipment.applicant</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="td_equipment_applicant_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No equipment applicants yet
            </p>
            <p>
                An applicant is registered automatically when a ticket gets a serial number
                and an applicant (a client or an EDRPOU).
            </p>
        </field>
    </record>

</odoo>
